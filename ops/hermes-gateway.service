[Unit]
Description=Hermes Gateway
After=network-online.target
Wants=network-online.target
# StartLimit* belong in [Unit], not [Service]. They tell systemd: if the unit
# (re)starts more than Burst times within IntervalSec, stop trying — a clear
# "this unit is broken" signal for operators instead of an infinite crashloop.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Default repo / ref. Override per-instance with a drop-in:
#   /etc/systemd/system/hermes-gateway.service.d/override.conf
# e.g. [Service]
#      Environment=HERMES_REF=afb43827f
Environment=HERMES_REPO_URL=https://github.com/Jhonnyr97/hermes-agent.git
Environment=HERMES_REF=main
Environment=CODE_DIR=/opt/hermes-agent
Environment=VENV_DIR=/opt/hermes-agent/venv
Environment=HERMES_HOME=/etc/hermes-agent
Environment=PATH=/opt/hermes-agent/venv/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/opt/hermes-agent
# Pull the desired ref, sanity-compile entrypoints. Failure here makes systemd
# leave Hermes on whatever it was running before — no crashloop on bad commits.
ExecStartPre=/opt/hermes-agent/ops/update-from-repo.sh
ExecStart=/opt/hermes-agent/venv/bin/hermes gateway run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
